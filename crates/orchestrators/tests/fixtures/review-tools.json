            "keep_current",
            "release",
            "retain_short",
            "retain_long",
            "retain_persistent"
          ],
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "revised_objective": {
          "type": "string"
        }
      },
      "required": [
        "decision",
        "rationale"
      ],
      "type": "object"
    }
  }
]
